  "scripts": {
    "test": "node --test test/sdk.test.mjs"
  },
  "license": "MIT",
  "author": "Om Sachin Salunke",
  "homepage": "https://github.com/om0852/XtraOS-Agent/tree/main/sdk/node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/om0852/XtraOS-Agent.git",
    "directory": "sdk/node"
  },
  "bugs": "https://github.com/om0852/XtraOS-Agent/issues",
  "keywords": ["xtraos", "ai-agent", "mcp", "windows", "ui-automation", "desktop-automation"],
